{
  "name": "khoda-ai-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static Khoda AI website and its CSS build tools",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.cjs -i styles/site.css -o assets/site.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i styles/site.css -o assets/site.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
